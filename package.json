{
  "name": "cursor-codex-handoff",
  "displayName": "Cursor Codex Handoff",
  "description": "Transfer conversation and repository context between Cursor Agent and the official Codex extension with bounded, deterministic handoffs.",
  "version": "0.1.1",
  "publisher": "handoff-ext",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/furkanaknc/handoff-extension.git"
  },
  "bugs": {
    "url": "https://github.com/furkanaknc/handoff-extension/issues"
  },
  "homepage": "https://github.com/furkanaknc/handoff-extension#readme",
  "keywords": [
    "cursor",
    "codex",
    "handoff",
    "context",
    "sync"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:handoff.cursorToCodex",
    "onCommand:handoff.codexToCursor",
    "onCommand:handoff.previewCursorToCodex",
    "onCommand:handoff.previewCodexToCursor",
    "onCommand:handoff.resetSyncState",
    "onCommand:handoff.showSyncDiagnostics",
    "onCommand:handoff.openControlCenter",
    "onCommand:handoff.checkIntegration",
    "onCommand:handoff.repairIntegration",
    "onCommand:handoff.removeIntegration"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "handoff.cursorToCodex",
        "title": "Handoff: Cursor → Codex"
      },
      {
        "command": "handoff.codexToCursor",
        "title": "Handoff: Codex → Cursor"
      },
      {
        "command": "handoff.previewCursorToCodex",
        "title": "Handoff: Preview Cursor → Codex"
      },
      {
        "command": "handoff.previewCodexToCursor",
        "title": "Handoff: Preview Codex → Cursor"
      },
      {
        "command": "handoff.resetSyncState",
        "title": "Handoff: Reset Sync State"
      },
      {
        "command": "handoff.showSyncDiagnostics",
        "title": "Handoff: Show Sync Diagnostics"
      },
      {
        "command": "handoff.openControlCenter",
        "title": "Handoff: Open Control Center"
      },
      {
        "command": "handoff.checkIntegration",
        "title": "Handoff: Check Integration"
      },
      {
        "command": "handoff.repairIntegration",
        "title": "Handoff: Repair Integration"
      },
      {
        "command": "handoff.removeIntegration",
        "title": "Handoff: Remove Integration / Hooks"
      }
    ],
    "keybindings": [
      {
        "command": "handoff.cursorToCodex",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      }
    ],
    "configuration": {
      "title": "Cursor Codex Handoff",
      "properties": {
        "handoff.codexTarget": {
          "type": "string",
          "enum": [
            "bound",
            "new",
            "active",
            "ask"
          ],
          "default": "bound",
          "description": "How to choose the Codex thread for Cursor → Codex handoffs. bound: reuse verified session binding; new: start a fresh thread; active: attach to the active Codex composer; ask: always show the thread picker."
        },
        "handoff.skipAttachmentConfirmation": {
          "type": "boolean",
          "default": false,
          "description": "Skip the Verify thread, then Attach handoff confirmation dialog after opening the Codex target."
        },
        "handoff.autoInstallHook": {
          "type": "boolean",
          "default": true,
          "description": "Attempt to install the Cursor conversation hook when the extension activates."
        },
        "handoff.maxHandoffTokens": {
          "type": "number",
          "default": 6000,
          "minimum": 500,
          "description": "Maximum estimated tokens for an outgoing handoff payload."
        },
        "handoff.maxConversationTokens": {
          "type": "number",
          "default": 4500,
          "minimum": 500,
          "description": "Maximum estimated conversation tokens in bootstrap or recovery handoffs."
        },
        "handoff.maxConversationMessages": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Deprecated hard cap on recent messages. Token budgets are preferred."
        },
        "handoff.maxConversationCharacters": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "description": "Deprecated hard cap on recent conversation characters. Token budgets are preferred."
        },
        "handoff.maxDiffBytes": {
          "type": "number",
          "default": 102400,
          "minimum": 0,
          "description": "Maximum Git diff size in bytes when handoff.includeFullDiff is enabled."
        },
        "handoff.includeFullDiff": {
          "type": "boolean",
          "default": false,
          "description": "Include the full Git diff in the model-facing handoff payload."
        },
        "handoff.includeCodexCommentary": {
          "type": "boolean",
          "default": false,
          "description": "Include Codex commentary and plan items in addition to final answers."
        },
        "handoff.codexRoutingTrust": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "How strictly to verify Codex thread routing before enabling delta sync."
        },
        "handoff.maxStoredHandoffs": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Maximum number of generated Markdown handoff files retained in extension storage."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "test": "npm run compile && node --test \"dist/test/*.test.js\"",
    "package:local": "npx --yes @vscode/vsce package --no-dependencies -o cursor-codex-handoff-latest.vsix",
    "install:local": "npm run package:local && cursor --install-extension .\\cursor-codex-handoff-latest.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
